# Copy this file to .env.local and fill it in. Never commit .env.local.
#
# URL of a form/email-list service that accepts a JSON POST like:
#   { "email": "person@example.com", "source": "vybe-landing" }
# Until this is set, the early-access form will tell visitors that signup is
# not connected and will NOT pretend to save their email.
VITE_EARLY_ACCESS_ENDPOINT=
